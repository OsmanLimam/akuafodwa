# Postgres connection string.
# Production: Neon POOLED string with pgbouncer flag appended, e.g.
#   postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# Local dev: any Postgres instance, e.g.
#   postgresql://postgres:postgres@localhost:5432/akuafodwa?sslmode=disable
DATABASE_URL=

# Web push (generate with: bunx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@akuafodwa.com

# Set to 1 on a fresh/empty database to auto-create the schema and load the
# demo market once on first visit. Remove once real data is live.
SEED_DEMO=

# ── Market WhatsApp line ──────────────────────────────────────────────
# Your market's WhatsApp number, international format (233 + number, no
# leading 0), digits only. Until it is set, the "chat with us" WhatsApp
# button stays hidden automatically. Example: 233244123456
NEXT_PUBLIC_MARKET_WHATSAPP=

# ── Demo seeding (LOCAL DEVELOPMENT ONLY) ─────────────────────────────
# SEED_DEMO=1 fills an EMPTY database with demo listings/accounts. It is
# blocked in production unless ALLOW_DEMO_SEED=1 is also set.
# DEMO_ADMIN_PASSWORD chooses the seeded admin's password (otherwise a
# random one is generated and printed in the seed log).
# SEED_DEMO=1
# DEMO_ADMIN_PASSWORD=
