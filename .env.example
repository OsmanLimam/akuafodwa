# SQLite database file (the single source of truth for all data)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Web push (generate with: bunx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@akuafodwa.com

# Set to 1 on a fresh host to auto-create the schema and load the demo market
SEED_DEMO=
